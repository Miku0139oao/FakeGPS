<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:gravity="center_horizontal"
              android:layoutDirection="ltr"
              android:orientation="vertical">

    <com.github.fakegps.ui.JoyStickButton
        android:id="@+id/btn_up"
        android:layout_width="@dimen/joystick_button"
        android:layout_height="@dimen/joystick_button"
        android:background="@drawable/bg_joystick_button"
        android:contentDescription="@string/cd_arrow_up"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_keyboard_arrow_up_black_24dp"
        app:tint="@color/brand_on_surface"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.github.fakegps.ui.JoyStickButton
            android:id="@+id/btn_left"
            android:layout_width="@dimen/joystick_button"
            android:layout_height="@dimen/joystick_button"
            android:background="@drawable/bg_joystick_button"
            android:contentDescription="@string/cd_arrow_left"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard_arrow_left_black_24dp"
            app:tint="@color/brand_on_surface"/>

        <com.github.fakegps.ui.JoyStickButton
            android:id="@+id/btn_right"
            android:layout_width="@dimen/joystick_button"
            android:layout_height="@dimen/joystick_button"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_joystick_button"
            android:contentDescription="@string/cd_arrow_right"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_keyboard_arrow_right_black_24dp"
            app:tint="@color/brand_on_surface"/>
    </LinearLayout>

    <com.github.fakegps.ui.JoyStickButton
        android:id="@+id/btn_down"
        android:layout_width="@dimen/joystick_button"
        android:layout_height="@dimen/joystick_button"
        android:background="@drawable/bg_joystick_button"
        android:contentDescription="@string/cd_arrow_down"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_keyboard_arrow_down_black_24dp"
        app:tint="@color/brand_on_surface"/>
</LinearLayout>
