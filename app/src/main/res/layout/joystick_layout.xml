<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              xmlns:app="http://schemas.android.com/apk/res-auto"
              android:layout_width="@dimen/joystick_width"
              android:layout_height="@dimen/joystick_height"
              android:background="@drawable/bg_joystick_panel"
              android:gravity="center_horizontal"
              android:orientation="vertical"
              android:padding="12dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_set_loc"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_joystick_button"
            android:contentDescription="@string/cd_set_location"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_set_loc"
            app:tint="@color/brand_on_surface"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_fly_to"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_joystick_button"
            android:contentDescription="@string/cd_fly_to"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flight_takeoff"
            app:tint="@color/brand_on_surface"/>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_bookmark"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_joystick_button"
            android:contentDescription="@string/cd_bookmark"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bookmark"
            app:tint="@color/brand_on_surface"/>
    </LinearLayout>

    <include
        layout="@layout/joystick_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btn_map_pick"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_joystick_button"
        android:contentDescription="@string/map_picker_title"
        android:padding="8dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_map"
        app:tint="@color/brand_on_surface"/>
</LinearLayout>
